		<!--9mm SMGs-->


	<Item name="_nospawn" 
	identifier="_smg_service" 
	Scale="0.36" 
	tags="smallitem,weapon,gun,gunsmith,mountableweapon" >

		<InventoryIcon texture="%ModDir%/Sprites/Items/Weapons/weaponsinv.png" sourcerect="370,415,62,77" origin="0.5,0.5" />
