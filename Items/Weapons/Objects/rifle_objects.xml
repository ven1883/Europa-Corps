<Items>


		<!--++++++++++++++++++++++++++++++++++++-->
		<!--5.56 rifles-->


	<Item name="_nospawn" 
	identifier="_rifle_assault"
	hideinmenus="true"
	tags="weapon,gun,gunsmith,rifleitem,mediumitem,mountableweapon" >

		<InventoryIcon texture="%ModDir%/Sprites/Items/Weapons/weaponsinv.png" sourcerect="116,0,54,80" origin="0.5,0.5" />
		<Sprite texture="%ModDir%/Sprites/Items/Weapons/rifles.png" sourcerect="0,145,98,75" depth="0.55" origin="0.5,0.5" />

		<Body width="140" height="60" density="50" />

		<Holdable controlpose="true" /> <!--!do not remove!-->
		<!--!due to bugtrauma, parents need a holdable or flashlights on guns break-->

		<RangedWeapon>
			<Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,256,256,256" />
			<CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,256,256,256" />

			<StatusEffect type="OnUse" target="This">
				<Explosion range="150.0" force="1" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" camerashake="9.0" />
			</StatusEffect>

			<StatusEffect type="OnUse" target="Contained">
				<Use />
			</StatusEffect>

			<RequiredItems msg="ItemmsgAmmoRequired" type="Contained" tags="556ammo" />
		</RangedWeapon>

		<ItemContainer>
			<Containable items="556ammo" hide="true">
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" condition="-100" stackable="false" />
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="1.05" condition="100" stackable="false" />
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="0.1" stackable="false" comparison="or">
					<Conditional EntityType="eq character" TargetContainer="True" />
					<Conditional EntityType="eq null" TargetContainer="True" />
					<sound file="%ModDir%/Sounds/Weapons/Guns/Reloads/riflereload1.ogg" type="OnUse" forceplay="true" range="900.0" loop="false" frequencymultiplier="0.9" volume="1" />
				</StatusEffect>
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="0.65" stackable="false" comparison="or">
					<Conditional EntityType="eq character" TargetContainer="True" />
					<Conditional EntityType="eq null" TargetContainer="True" />
					<sound file="%ModDir%/Sounds/Weapons/Guns/Reloads/riflereload2.ogg" type="OnUse" forceplay="true" range="900.0" loop="false" frequencymultiplier="0.9" volume="1" />
				</StatusEffect>
			</Containable>
		</ItemContainer>
	</Item>


		<!--++++++++++++++++++++++++++++++++++++-->
		<!--Assault Pistols (10mm)-->


	<Item name="_nospawn" 
