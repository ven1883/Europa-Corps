				</StatusEffect>
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="0.65" stackable="false" comparison="or">
					<Conditional EntityType="eq character" TargetContainer="True" />
					<Conditional EntityType="eq null" TargetContainer="True" />
					<sound file="%ModDir%/Sounds/Weapons/Guns/Reloads/pistolreload2.ogg" type="OnUse" forceplay="true" range="900.0" loop="false" frequencymultiplier="0.9" volume="1" />
				</StatusEffect>
			</Containable>
		</ItemContainer>
	</Item>