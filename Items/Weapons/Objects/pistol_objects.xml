	<!--9mm pistols-->
	<Item name="" 
	identifier="_object_weapon_pistol_base"
	variantof="_object_weapon_pistol"
	description="" 
	category="Weapon" 
	hideinmenus="true"
	tags="weapon,gun,gunsmith,pistolitem,smallitem" >

		<Holdable slots="Any,RightHand,LeftHand" controlpose="true" aimpos="70,5" handle1="-40,-7" msg="ItemMsgPickUpSelect"/>

		<RangedWeapon>
			<Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,256,256,256" />
			<CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,256,256,256" />

			<ParticleEmitter particle="muzzleflash" particleamount="1" velocitymin="0" velocitymax="0" />

			<StatusEffect type="OnUse" target="This">
				<Explosion range="150.0" force="1.1" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" camerashake="4.0" />
			</StatusEffect>

			<StatusEffect type="OnUse" target="Contained">
				<Use />
			</StatusEffect>

			<RequiredItems msg="ItemmsgAmmoRequired" type="Contained" tags="9mmpistolammo" />
		</RangedWeapon>

		<ItemContainer>
			<Containable items="9mmpistolammo" hide="true">
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="1.05" condition="100" stackable="false" />
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" condition="-100" stackable="false" />
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="0.1" stackable="false" comparison="or">
					<Conditional EntityType="eq character" TargetContainer="True" />
					<Conditional EntityType="eq null" TargetContainer="True" />
					<sound file="%ModDir%/Sounds/pistolreload1.ogg" type="OnUse" forceplay="true" range="900.0" loop="false" frequencymultiplier="0.9" volume="1" />
				</StatusEffect>
				<StatusEffect type="OnInserted" target="This" targetslot="0" disabledeltatime="true" delay="0.65" stackable="false" comparison="or">
					<Conditional EntityType="eq character" TargetContainer="True" />
					<Conditional EntityType="eq null" TargetContainer="True" />
					<sound file="%ModDir%/Sounds/pistolreload2.ogg" type="OnUse" forceplay="true" range="900.0" loop="false" frequencymultiplier="0.9" volume="1" />
				</StatusEffect>
			</Containable>
		</ItemContainer>
	</Item>

